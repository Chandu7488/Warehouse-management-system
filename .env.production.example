# StockPilot WMS - Production Environment Configuration Template
# Copy this file to .env in production deployment

NODE_ENV=production
PORT=5000

# MongoDB Atlas Production Cluster Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stockpilot_production?retryWrites=true&w=majority

# Production Domain / Client Origin (Must match exact HTTPS domain)
CLIENT_URL=https://wms.stockpilot.local

# High-entropy Cryptographic Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace_with_64_character_hex_string_for_access_token_signing
JWT_REFRESH_SECRET=replace_with_different_64_character_hex_string_for_refresh_token

# Lifetimes & Security Flags
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true
LOG_LEVEL=info
